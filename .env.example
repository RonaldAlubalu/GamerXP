# Copy to .env and fill in. Never commit .env.

# --- Required ------------------------------------------------------------------
DOMAIN=gamerxp.nl
PUBLIC_URL=https://gamerxp.nl
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# --- Bookings ------------------------------------------------------------------
# Availability (schedule, slot hours, capacity, booking window) is set in the
# admin page under "Beschikbaarheid".
TIMEZONE=Europe/Amsterdam
# Deposit asked on confirmation and price per extra game station, in cents.
DEPOSIT_CENTS=10000
EXTRA_STATION_CENTS=2500
# Optional payment instructions added to the confirmation email.
PAYMENT_INFO=

# --- Email (SMTP) --------------------------------------------------------------
# Leave SMTP_HOST empty to only log emails (handy while testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gamer Xperience <contact@gamerxp.nl>
# Receives notifications for new bookings and contact messages.
OWNER_EMAIL=contact@gamerxp.nl

# --- Other ---------------------------------------------------------------------
SESSION_TTL_HOURS=12
BACKUP_KEEP_DAYS=14
