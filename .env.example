# Copy to .env and fill in. Never commit .env.

# --- Required ------------------------------------------------------------------
DOMAIN=gamerxp.nl
PUBLIC_URL=https://gamerxp.nl
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# --- Bookings ------------------------------------------------------------------
# How many parties you can do on the same day (number of setups you own).
DAILY_CAPACITY=1
# Minimum days between booking and party.
MIN_LEAD_DAYS=3
# How far ahead parents can book.
MAX_ADVANCE_DAYS=365
TIMEZONE=Europe/Amsterdam

# --- Email (SMTP) --------------------------------------------------------------
# Leave SMTP_HOST empty to only log emails (handy while testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GamerXP <info@gamerxp.nl>
# Receives notifications for new bookings and contact messages.
OWNER_EMAIL=info@gamerxp.nl

# --- Other ---------------------------------------------------------------------
SESSION_TTL_HOURS=12
BACKUP_KEEP_DAYS=14
