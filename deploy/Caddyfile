# Caddy obtains and renews HTTPS certificates automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Other addresses of this site (an earlier test address, a second domain) lead to the main one.
# Temporary on purpose: which address is the main one changes when a domain is taken into use.
{$EXTRA_DOMAINS:unused.localhost} {
	redir https://{$DOMAIN}{uri} temporary
}

# A second, separate site on the same server: plain pages from /srv/gatra/public on the server
# (read-only in this container). Its files come from a deploy of their own repository
# (RonaldAlubalu/GatraNL), not from this one.
# For now on a test address, kept out of search engines.
{$GATRA_DOMAIN:gatra.localhost} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	root * /srv/gatra
	file_server
}
