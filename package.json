{
  "name": "gamerxp",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted website and booking backend for GamerXP gaming LAN parties",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "create-admin": "node dist/scripts/create-admin.js",
    "create-admin:dev": "tsx src/scripts/create-admin.ts",
    "seed-demo": "node dist/scripts/seed-demo.js",
    "seed-demo:dev": "tsx src/scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
